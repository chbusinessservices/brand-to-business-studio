# Public Backend Variables (These CAN be committed)
SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_URL="https://your-project-id.supabase.co"

# Google OAuth Required for Production Login
GOOGLE_CLIENT_ID="REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID_FROM_OAUTH2_CONSOLE.GOOGLE.COM"
GOOGLE_REDIRECT_URI="https://chbusinessservices.pro/auth/sign-in?provider=google"
GOOGLE_CALLBACK_URL="https://chbusinessservices.pro/auth/callback"

# Supabase Service Role (For server-side operations - DO NOT COMMIT)
# Get this from: supabase.com/settings > Project Settings > API > Service Role key
AUTH_SERVICE_ROLE="REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY"
